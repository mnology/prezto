# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

eval "$(mise activate zsh)"

# Generated for envman. Do not edit.
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

# PATHs
export PYENV_ROOT="$HOME/.pyenv"
export GOENV_ROOT="$HOME/.goenv"
export RBENV_ROOT=~/devel/dotfiles/rbenv
export PATH="$PATH:$PYENV_ROOT/bin:$GOENV_ROOT/bin:$HOME/.poetry/bin:$HOME/.cargo/bin"

# pyenv
eval "$(pyenv init --path)"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm

# go
eval "$(goenv init -)"

# rbenv
eval "$(${RBENV_ROOT}/bin/rbenv init -)"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/tmp/google-cloud-sdk/path.zsh.inc' ]; then
  . '/tmp/google-cloud-sdk/path.zsh.inc'
fi

# The next line enables shell command completion for gcloud.
if [ -f '/tmp/google-cloud-sdk/completion.zsh.inc' ]; then
  . '/tmp/google-cloud-sdk/completion.zsh.inc'
fi

# shell integrations
eval "$(zoxide init zsh)"
eval "$(atuin init zsh)"
eval "$(direnv hook zsh)"

# tinty shell theming
eval "$(tinty init)"
export LS_COLORS="$(cat ~/.cache/vivid-theme.txt)"

# prompt
eval "$(starship init zsh)"

# aliases/functions
for f in ~/.config/shell/*.sh; do
  [[ -r "$f" ]] && source "$f"
done

export LS_COLORS="$(vivid generate ansi)"
export EDITOR="v"
export PAGER="cat"
